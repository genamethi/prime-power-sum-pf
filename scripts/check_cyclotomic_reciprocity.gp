\\ Run: gp -fq -s 64M check_cyclotomic_reciprocity.gp
\\ The report is replaced, not appended.
read("cyclotomic_reciprocity.gp");

run_reciprocity_checks() = {
  my(qs=[433,1777,2113,2833,4177,48817,54001,61681,100801,
         155377,165313,274177,340801,414721,525313,858001,2787601,15790321]);
  my(output="cyclotomic-reciprocity-tables.md", rows=List());
  my(direct_checks=0, local_checks=0, full_local=List(), witnesses=List());
  for(j=1,#qs,
    my(q=qs[j],r=znorder(Mod(2,q)),f=factor(r),all_local=1,has_witness=0);
    for(i=1,matsize(f)[1],
      my(m=f[i,1]^f[i,2], data=grouped_residue(q,m));
      my(result=check_grouped_case(q,m,factor(data[4])), away=result[3]);
      my(local_ok=result[4]);
      direct_checks++;
      if(local_ok,local_checks++,all_local=0);
      if(local_ok && data[7]!=1,has_witness=1);
      listput(rows,[q,r,data[2],m,local_ok,data[7],data[8],away[2]])
    );
    if(all_local,listput(full_local,q));
    if(has_witness,listput(witnesses,q))
  );
  \\ rho=2: check every prime-power level, including the smaller levels.
  for(j=1,2,
    my(q=[1093,3511][j],r=znorder(Mod(2,q)),f=factor(r));
    for(i=1,matsize(f)[1],for(b=1,f[i,2],
      my(m=f[i,1]^b,result=check_grouped_case(q,m),data=result[1],direct="not factored");
      require(data[2]==2,"expected repeated q-factor");
      if(q==1093,
        my(away=grouped_factor_symbols(q,m,factor(data[4])));
        direct=away[2]; direct_checks++;
        if(result[4],require(direct==data[8],"rho=2 reciprocity mismatch");local_checks++)
      );
      listput(rows,[q,r,data[2],m,result[4],data[7],data[8],direct])
    ))
  );
  \\ Explicit tests of the general relative-norm calculation.
  for(j=1,4,
    my(cases=[[433,9,3],[433,72,9],[54001,180,5],[1093,364,13]]);
    my(q=cases[j][1],t=cases[j][2],m=cases[j][3]);
    my(atq=symbols_above_q(q,t,m),away=symbols_away_from_q(q,t,m));
    if(local_correction_vanishes(q,m),require(atq[3]==away[2],"relative-norm reciprocity mismatch"))
  );
  \\ Nontrivial factors can cancel in the product.
  my(cancel=grouped_factor_symbols(433,8,factor(grouped_residue(433,8)[4])));
  require(cancel[2]==0 && cancel[1][1][4]==6 && cancel[1][2][4]==2,
          "expected cancellation example");
  \\ Independent small primitive factor for the unfactored q=3511 norm.
  require(isprime(262657) && znorder(Mod(2,262657))==27,"bad primitive factor");
  require(Mod(3511,262657)^((262657-1)/3)==512,"bad cubic witness");

  my(text=Str("# Cyclotomic reciprocity calculations\n\n",
    "Generated by `check_cyclotomic_reciprocity.gp`. Definitions and proof are in ",
    "[cyclotomic-reciprocity.md](cyclotomic-reciprocity.md).\n\n",
    "For the first 18 q values, m runs over the full prime-power factors of r. ",
    "For q=1093 and 3511, every prime-power level is included. ",
    "These are structural examples, not solutions of the original system.\n\n",
    "The local column is 1 when q is 1 modulo sm (odd s) or 2m (s=2). ",
    "Under this condition, T is the computed product of the power-residue symbols away from q and s. ",
    "A nontrivial T is then a certificate; when the local column is 0 the omitted local contribution must be included. ",
    "Exponent k means that the symbol is zeta_m^k.\n\n",
    "| q | r | rho | m | local condition | T mod q | k from q | k from factors |\n",
    "| --- | --- | --- | --- | --- | --- | --- | --- |\n"));
  for(j=1,#rows,
    my(row=rows[j]);
    text=Str(text,"| ",row[1]," | ",row[2]," | ",row[3]," | ",row[4],
      " | ",row[5]," | ",row[6]," | ",row[7]," | ",row[8]," |\n")
  );
  text=Str(text,"\n",direct_checks," complete-factor calculations; ",local_checks,
    " had the stated local condition, and all agreed with the q-adic calculation.\n\n",
    "Among the first 18 examples, the q values passing every local condition are ",Vec(full_local),
    ". All three have a nontrivial product. Some tested m with the local condition supplies a nontrivial product for ",
    #witnesses," of the 18 q values. All 18 have rho=1.\n\n",
    "For rho=2, q=1093 has T=-1 at m=2. For q=3511, T=756 at m=3 ",
    "and T=1942 at m=9. The latter norm was not factored. The prime 262657 ",
    "independently gives 3511^87552 = 512 modulo 262657. ",
    "Both q values already fail other remaining-case restrictions.\n");
  \\ write() appends; write the complete report through a fresh file handle.
  my(handle=fileopen(output,"w")); filewrite(handle,text); fileclose(handle);
  print("Verified ",direct_checks," factorizations, ",local_checks,
        " reciprocity equalities, q-adic/derivative agreement for ",#rows,
        " cases, and the cancellation and rho=2 examples.");
};

iferr(run_reciprocity_checks(),err,print(err);quit(1));
quit(0);
